{
  "id": "paper-plugin-maven",
  "name": "Paper Plugin (Maven)",
  "version": "1.0.0",
  "description": "Paper Plugin using Maven (Java 25+)",
  "type": "minecraft-plugin",
  "requirements": {
    "java": "25",
    "buildSystem": "maven"
  },
  "variables": [
    { "name": "PROJECT_NAME", "required": true },
